# Football Data API (used by Netlify function – set in Netlify dashboard for production)
# FOOTBALL_API_TOKEN=your_api_token_here
# FOOTBALL_API_URL=https://api.football-data.org/v4

# Leave unset for `npm start`. package.json "proxy" forwards /.netlify/functions to the deployed site.
# Setting this to the deployed URL makes the browser call that site directly and fails CORS until the functions are redeployed.
# REACT_APP_STANDINGS_API_URL=https://euleague.netlify.app

# App display
REACT_APP_APP_NAME=Football Standings
REACT_APP_VERSION=1.0.1
